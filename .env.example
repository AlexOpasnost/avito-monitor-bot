# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=123456789:ABCdefGhIjKlMnOpQrStUvWxYz

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/avito_monitor

# Proxies (comma-separated, optional)
# Formats: http://ip:port, http://user:pass@ip:port, socks5://ip:port
PROXY_LIST=

# Parse interval in seconds (default: 300 = 5 min)
PARSE_INTERVAL=300

# Max subscriptions per user (default: 5)
MAX_SUBSCRIPTIONS=5
