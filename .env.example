# Telegram Bot Token — get from @BotFather (required)
BOT_TOKEN=123456789:ABCdefGhIjKlMnOpQrStUvWxYz

# PostgreSQL connection string (required). On Railway use the
# DATABASE_URL the Postgres service injects automatically.
DATABASE_URL=postgresql://user:password@localhost:5432/avito_monitor

# Proxies (comma-separated, optional). Only Avito + Kufar route
# through this list; OLX / Vinted / Mercari go direct.
# Formats: http://ip:port, http://user:pass@ip:port, socks5://ip:port
PROXY_LIST=

# Mobile-proxy IP rotation endpoint (optional). If set, the bot
# rotates the proxy IP on every cycle instead of holding the same
# session. Format: provider-specific URL, e.g.
# https://changeip.mobileproxy.space/?proxy_key=...&format=json
PROXY_ROTATE_URL=

# How often each subscription is checked, in seconds (default 60).
# Lower = faster notifications but heavier on the proxy / target site.
PARSE_INTERVAL=60

# Maximum subscriptions per user fallback (default 5). The
# per-tariff limit (1 / 1 / 3 / 5 for trial / basic / advanced / pro)
# overrides this — env var only matters before the paywall is wired up.
MAX_SUBSCRIPTIONS=5

# ---------------------------------------------------------------------
# YooKassa REST API + webhook — required for the paywall
# ---------------------------------------------------------------------
# YooKassa shop credentials. Get from yookassa.ru → Настройки → API.
# We use the REST API path (not Telegram-Payments-native) so the
# checkout supports СБП / Apple Pay / SberPay / YooMoney / cards.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Public HTTPS URL of THIS service (Railway → Networking →
# Generate Domain). YooKassa POSTs to {WEBHOOK_BASE_URL}/webhook/yookassa
# after a successful payment; without this, paid tariffs never activate.
# Example: https://avito-monitor-bot-production.up.railway.app
WEBHOOK_BASE_URL=

# Port the embedded aiohttp webhook server listens on. Railway
# overrides this with $PORT automatically — leave default for local.
WEBHOOK_PORT=8000

# Legacy Telegram-Payments token from @BotFather. Kept for back-compat
# but no longer used by the paywall (REST path supersedes it). Safe to
# leave empty.
PAYMENT_PROVIDER_TOKEN=

# ---------------------------------------------------------------------
# Admin panel
# ---------------------------------------------------------------------
# Comma-separated Telegram user IDs that get the /admin command and an
# auto-assigned 'admin' tariff (999 searches, no expiry). Find a tg_id
# via @userinfobot or by reading /admin users on a friend's account.
ADMIN_IDS=

# Single-admin back-compat — used only if ADMIN_IDS is empty.
ADMIN_ID=0

# Support contact shown when payment isn't configured or activation
# falls back to manual handling (e.g. "@autosearch_support").
SUPPORT_HANDLE=

# ---------------------------------------------------------------------
# Branding
# ---------------------------------------------------------------------
BRAND_NAME=AutoSearch

# Legacy two-tier price labels (kept for back-compat — current paywall
# uses the inline _TARIFFS table in handlers.py).
BASIC_PRICE_RUB=890
PRO_PRICE_RUB=2590
PAYMENT_URL_BASIC=
PAYMENT_URL_PRO=

# ---------------------------------------------------------------------
# Telegram API endpoint (optional — for users with a custom proxy)
# ---------------------------------------------------------------------
# A Cloudflare Worker (or similar) that proxies api.telegram.org. Useful
# in regions where Telegram's API is throttled. Leave empty to use the
# stock https://api.telegram.org.
TELEGRAM_API_URL=https://api.telegram.org

# ---------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------
MAX_CONCURRENT_REQUESTS=3
HEADLESS=true
